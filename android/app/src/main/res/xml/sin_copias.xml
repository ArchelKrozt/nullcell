<?xml version="1.0" encoding="utf-8"?>
<!-- La identidad de la celda es una clave privada: nunca a copias en la nube. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="file" /></device-transfer>
</data-extraction-rules>
